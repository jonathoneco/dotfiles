#!/usr/bin/env python3
"""Supported native theme families: offline palettes, live preview, and rollback."""
import argparse
import base64
from contextlib import contextmanager
import fcntl
import json
import os
from pathlib import Path
import re
import shlex
import signal
import subprocess
import sys
import tempfile
import time

ROOT = Path(__file__).resolve().parents[1]
HOME = Path.home()
CONFIG_HOME = Path(os.environ.get('XDG_CONFIG_HOME', HOME / '.config'))
CONFIG = CONFIG_HOME / 'ghostty/config.ghostty'
HERDR = Path(os.environ.get('HERDR_THEME_FILE', CONFIG_HOME / 'herdr/themes/ghostty.toml'))
FAVORITES = CONFIG_HOME / 'ghostty/favorite-themes'
STATE = Path(os.environ.get('XDG_STATE_HOME', HOME / '.local/state')) / 'ghostty-theme'
CATALOG = Path(os.environ.get('THEME_FAMILIES_DIR', ROOT / 'config/theme-families'))
THEME_LINE = re.compile(r'^theme[ \t]*=[ \t]*"([^"]*)"[ \t]*$', re.M)
HEX = re.compile(r'#[0-9a-f]{6}\Z')
ID = re.compile(r'[a-z][a-z0-9-]*\Z')
TABS = ('Favorites', 'Adaptive', 'Dark', 'Light', 'All')


def theme_name(family, variant):
    return f'dotfiles-{family}-{variant}'


def catalog():
    choices, families, signatures = {}, [], set()
    for path in sorted(CATALOG.glob('*.json')):
        family = json.loads(path.read_text())
        ident = family['id']
        if family['schema'] != 1 or not ID.fullmatch(ident) or path.stem != ident:
            raise ValueError(f'{path}: invalid schema or family id')
        native = family['native']
        if not re.fullmatch(r'[\w.-]+/[\w.-]+', native['repository']) or not re.fullmatch(r'[0-9a-f]{40}', native['commit']):
            raise ValueError(f'{path}: invalid native repository or commit')
        for key in ('colorscheme', 'lualine_module'):
            if key == 'lualine_module' and native[key] is None:
                continue
            if not re.fullmatch(r'[\w.-]+', native[key]):
                raise ValueError(f'{path}: invalid {key}')
        for variant, data in family['variants'].items():
            if not ID.fullmatch(variant) or data['appearance'] not in ('light', 'dark'):
                raise ValueError(f'{path}: invalid variant {variant}')
            if 'lualine_module' in data and not re.fullmatch(r'[\w.-]+', data['lualine_module']):
                raise ValueError(f'{path}: invalid native status-line module in {variant}')
            palette = data['terminal']
            if len(palette['ansi']) != 16:
                raise ValueError(f'{path}: {variant} needs 16 ANSI colors')
            colors = [palette[k] for k in ('background', 'foreground', 'cursor', 'cursor_text', 'selection_background', 'selection_foreground')] + palette['ansi']
            if any(not isinstance(c, str) or not HEX.fullmatch(c) for c in colors):
                raise ValueError(f'{path}: invalid RGB color in {variant}')
            signature = tuple([palette['background'], palette['foreground'], *palette['ansi'][1:7]])
            if signature in signatures:
                raise ValueError(f'{path}: duplicate palette signature for {variant}')
            signatures.add(signature)
            name = theme_name(ident, variant)
            choices[name] = (f"{family['label']} · {variant}", data['appearance'])
        pair = family['adaptive']
        if pair is not None:
            for appearance in ('light', 'dark'):
                if family['variants'][pair[appearance]]['appearance'] != appearance:
                    raise ValueError(f'{path}: invalid adaptive {appearance} member')
            value = f"light:{theme_name(ident, pair['light'])},dark:{theme_name(ident, pair['dark'])}"
            choices[value] = (f"{family['label']} · adaptive", 'adaptive')
        families.append(family)
    if not families:
        raise ValueError(f'{CATALOG}: no supported theme families')
    return families, choices


def ghostty_text(family, variant, data):
    p = data['terminal']
    lines = [f"# Generated from {family['native']['repository']} at {family['native']['commit']}. Do not edit."]
    for field in ('background', 'foreground', 'cursor', 'cursor_text', 'selection_background', 'selection_foreground'):
        setting = {'cursor': 'cursor-color', 'cursor_text': 'cursor-text'}.get(field, field.replace('_', '-'))
        lines.append(f'{setting} = {p[field]}')
    lines.extend(f'palette = {i}={color}' for i, color in enumerate(p['ansi']))
    return '\n'.join(lines) + '\n'


def compile_catalog(check=False):
    families, _ = catalog()
    directory = ROOT / 'config/ghostty/themes'
    expected = set()
    lock = json.loads((ROOT / 'config/nvim/lazy-lock.json').read_text())
    for family in families:
        ident, native = family['id'], family['native']
        adapter = ROOT / f'config/nvim/lua/config/theme_families/{ident}.lua'
        if not adapter.is_file():
            raise ValueError(f'{ident}: native adapter is missing')
        if check and lock.get(ident, {}).get('commit') != native['commit']:
            raise ValueError(f'{ident}: lazy-lock.json does not match native revision')
        for variant, data in family['variants'].items():
            path = directory / theme_name(ident, variant)
            expected.add(path)
            content = ghostty_text(family, variant, data).encode()
            if check:
                if read_bytes(path) != content:
                    raise ValueError(f'{path}: stale generated palette; run ghostty-theme --compile')
            else:
                write_bytes(path, content)
    stale = set(directory.glob('dotfiles-*')) - expected
    if stale:
        raise ValueError(f'unreferenced generated palettes: {sorted(map(str, stale))}')


def read_bytes(path):
    return path.read_bytes() if path.exists() else None


def write_bytes(path, data):
    path = path.resolve()
    path.parent.mkdir(parents=True, exist_ok=True)
    mode = path.stat().st_mode & 0o777 if path.exists() else 0o644
    fd, temporary = tempfile.mkstemp(dir=path.parent, prefix='.' + path.name)
    try:
        with os.fdopen(fd, 'wb') as out:
            out.write(data)
            out.flush()
            os.fsync(out.fileno())
        os.chmod(temporary, mode)
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def current_theme(path=CONFIG):
    matches = THEME_LINE.findall(path.read_text())
    if len(matches) != 1:
        raise ValueError(f'{path}: expected exactly one quoted theme line')
    return matches[0]


def set_theme(value):
    text = CONFIG.read_text()
    if len(THEME_LINE.findall(text)) != 1:
        raise ValueError(f'{CONFIG}: expected exactly one quoted theme line')
    write_bytes(CONFIG, THEME_LINE.sub(lambda _: f'theme = "{value}"', text).encode())


def palette_file(name):
    if not name or Path(name).name != name:
        raise ValueError(f'invalid theme name: {name!r}')
    directories = [CONFIG_HOME / 'ghostty/themes', ROOT / 'config/ghostty/themes']
    resources = os.environ.get('GHOSTTY_RESOURCES_DIR')
    if resources:
        directories.append(Path(resources) / 'themes')
    directories += [Path('/Applications/Ghostty.app/Contents/Resources/ghostty/themes'), Path('/usr/share/ghostty/themes')]
    return next((d / name for d in directories if (d / name).is_file()), None)


def herdr_colors(name):
    path = palette_file(name)
    if path is None:
        raise ValueError(f'no installed Ghostty palette named {name!r}')
    text = path.read_text()
    matches = [re.search(pattern, text, re.M) for pattern in (r'^background\s*=\s*(#[\da-fA-F]{6})', r'^foreground\s*=\s*(#[\da-fA-F]{6})', r'^palette\s*=\s*4=(#[\da-fA-F]{6})')]
    if not all(matches):
        raise ValueError(f'{path}: missing background, foreground or palette 4')
    bg, fg, accent = [match[1] for match in matches]
    def rgb(color):
        return [int(color[i:i+2], 16) for i in (1, 3, 5)]
    def lum(color):
        channels = [v / 255 for v in rgb(color)]
        linear = [v / 12.92 if v <= .03928 else ((v + .055) / 1.055) ** 2.4 for v in channels]
        return sum(v * w for v, w in zip(linear, (.2126, .7152, .0722)))
    def ratio(color):
        a, b = sorted((lum(color), lum(accent)))
        return (b + .05) / (a + .05)
    def mix(t):
        return '#' + ''.join(f'{int(a + (b-a)*t + .5):02x}' for a, b in zip(rgb(bg), rgb(fg)))
    text_on = max((bg, fg), key=ratio)
    if ratio(text_on) < 4.5:
        text_on = max(('#000000', '#ffffff'), key=ratio)
    return f'accent = "{accent}"\naccent_text = "{text_on}"\nactive_row_bg = "{mix(.15)}"\nsurface_dim = "{mix(.30)}"\n' + ''.join(f'{key} = "reset"\n' for key in ('overlay0', 'overlay1', 'subtext0', 'mauve'))


def render_herdr(value):
    pair = re.fullmatch(r'light:([^,]+),dark:([^,]+)', value)
    try:
        if pair:
            light, dark = pair.groups()
            body = herdr_colors(dark) + '\n[light]\n' + herdr_colors(light) + '\n[dark]\n' + herdr_colors(dark)
        else:
            body = herdr_colors(value)
    except ValueError:
        if any(palette_file(name) for name in (pair.groups() if pair else [value])):
            raise
        print(f'ghostty-theme: palette unavailable for {value!r}; Herdr uses terminal colors', file=sys.stderr)
        body = ''
    return (f'# Generated by ghostty-theme from Ghostty theme "{value}". Do not edit.\nbase = "terminal"\n' + body).encode()


def reload_apps():
    output = subprocess.check_output(['ps', '-axo', 'pid=,comm='], text=True)
    for line in output.splitlines():
        pid, command = line.strip().split(None, 1)
        if Path(command).name == 'ghostty':
            try:
                os.kill(int(pid), signal.SIGUSR2)
            except ProcessLookupError:
                pass
    result = subprocess.run([os.environ.get('HERDR_BIN_PATH', 'herdr'), 'server', 'reload-config'],
                            check=True, stdout=subprocess.PIPE, text=True)
    try:
        response = json.loads(result.stdout)
    except json.JSONDecodeError:
        raise ValueError('Herdr returned an invalid config reload report') from None
    report = response.get('result') if isinstance(response, dict) else None
    if not isinstance(report, dict) or report.get('status') != 'applied':
        raise ValueError(f'Herdr config reload did not apply: {result.stdout.strip()}')
    time.sleep(.2)
    output = subprocess.check_output(['ps', '-axo', 'pid=,args='], text=True)
    for line in output.splitlines():
        pid, command = line.strip().split(None, 1)
        words = command.split()
        if Path(words[0]).name in ('herdr', 'herdr-upstream') and not any(w in words[1:] for w in ('server', 'remote-daemon', 'remote-client-bridge')):
            try:
                os.kill(int(pid), signal.SIGWINCH)
            except ProcessLookupError:
                pass


@contextmanager
def locked(path, blocking=True):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open('a') as out:
        try:
            fcntl.flock(out, fcntl.LOCK_EX | (0 if blocking else fcntl.LOCK_NB))
        except BlockingIOError:
            raise ValueError('a theme picker is already open') from None
        yield


def encoded(data):
    return base64.b64encode(data).decode() if data is not None else None


def snapshot():
    return {'theme': current_theme(), 'herdr': encoded(read_bytes(HERDR))}


def save_journal(data):
    write_bytes(STATE / 'preview.json', (json.dumps(data) + '\n').encode())


def ensure_owned(journal):
    actual = snapshot()
    if actual['theme'] not in journal['allowed_themes'] or actual['herdr'] not in journal['allowed_herdr']:
        raise ValueError(f'theme files changed outside this picker; preserving them. Recovery record: {STATE / "preview.json"}')


def restore(journal):
    ensure_owned(journal)
    baseline = journal['baseline']
    if snapshot() != baseline or journal['applied'] != baseline:
        set_theme(baseline['theme'])
        if baseline['herdr'] is None:
            HERDR.unlink(missing_ok=True)
        else:
            write_bytes(HERDR, base64.b64decode(baseline['herdr']))
        reload_apps()


def recover(session_lock_held=False):
    path = STATE / 'preview.json'
    if path.exists():
        journal = json.loads(path.read_text())
        session = Path(journal['session']) if journal.get('session') else None
        if session and session.is_dir() and not session_lock_held:
            with locked(session / 'callback.lock'):
                (session / 'closed').touch()
                recover(session_lock_held=True)
            return
        if not journal['accepted']:
            restore(journal)
            print('ghostty-theme: restored interrupted preview', file=sys.stderr)
        path.unlink()


class Picker:
    def __init__(self, choices, session):
        self.choices, self.session = choices, session
        baseline = snapshot()
        self.journal = {'baseline': baseline, 'allowed_themes': [baseline['theme']], 'allowed_herdr': [baseline['herdr']], 'accepted': False, 'applied': baseline, 'session': str(session) if session else None}
        save_journal(self.journal)

    def preview(self, value):
        self.journal = json.loads((STATE / 'preview.json').read_text())
        if value not in self.choices:
            if value != self.journal['baseline']['theme']:
                raise ValueError(f'unsupported theme choice: {value!r}')
            restore(self.journal)
            self.journal['applied'] = self.journal['baseline']
            save_journal(self.journal)
            return
        ensure_owned(self.journal)
        content = render_herdr(value)
        desired = {'theme': value, 'herdr': encoded(content)}
        if snapshot() == desired and self.journal['applied'] == desired:
            return
        self.record_pending_write(value, content)
        write_bytes(HERDR, content)
        set_theme(value)
        reload_apps()
        self.journal['applied'] = desired
        save_journal(self.journal)

    def record_pending_write(self, value, content):
        self.journal['applied'] = None
        self.journal['allowed_themes'] = list(set([current_theme(), value, self.journal['baseline']['theme']]))
        self.journal['allowed_herdr'] = list(set([encoded(read_bytes(HERDR)), encoded(content), self.journal['baseline']['herdr']]))
        save_journal(self.journal)

    def commit(self, value):
        self.preview(value)
        self.journal = json.loads((STATE / 'preview.json').read_text())
        ensure_owned(self.journal)
        self.journal['accepted'] = True
        save_journal(self.journal)


def favorite_values():
    return FAVORITES.read_text().splitlines() if FAVORITES.exists() else []


def rows(choices, tab, baseline):
    favorites = favorite_values()
    values = ([v for v in favorites if v in choices] if tab == 'Favorites' else
              [v for v, (_, appearance) in choices.items() if tab == 'All' or appearance == tab.lower()])
    if baseline not in choices and tab == 'All':
        values.insert(0, baseline)
    lines = []
    for value in values:
        label = choices[value][0] if value in choices else f'Current · {value} · unsupported'
        lines.append(f'{"★" if value in favorites else " "}\t{label}\t{value}')
    return '\n'.join(lines) + ('\n' if lines else '')


def tab_header(tab):
    return '  '.join(f'[{name}]' if name == tab else name for name in TABS)


def callback(session, action, value):
    session = Path(session)
    with locked(session / 'callback.lock'):
        if (session / 'closed').exists():
            return
        owner = json.loads((session / 'owner.json').read_text())
        if not (STATE / 'preview.json').exists():
            raise ValueError('theme preview session has ended')
        os.kill(owner['pid'], 0)
        if json.loads((STATE / 'preview.json').read_text()).get('session') != str(session):
            raise ValueError('stale theme preview callback')
        _, choices = catalog()
        tab = (session / 'tab').read_text()
        if action == 'list':
            print(rows(choices, tab, owner['baseline']), end='')
        elif action == 'tab':
            tab = TABS[(TABS.index(tab) + (-1 if value == 'backward' else 1)) % len(TABS)]
            (session / 'tab').write_text(tab)
            first = rows(choices, tab, owner['baseline']).splitlines()
            write_bytes(session / 'request', (first[0].split('\t')[2] if first else '').encode())
            command = shlex.join([str(Path(__file__).resolve()), '--callback', str(session), 'list'])
            print(f'change-header({tab_header(tab)})+reload-sync({command})+first')
        elif action == 'star' and value in choices:
            favorites = favorite_values()
            favorites = [v for v in favorites if v != value] if value in favorites else favorites + [value]
            write_bytes(FAVORITES, ('\n'.join(favorites) + '\n').encode())


def run_picker(choices):
    baseline = current_theme()
    with tempfile.TemporaryDirectory(prefix='theme-picker-') as directory:
        session = Path(directory)
        (session / 'owner.json').write_text(json.dumps({'pid': os.getpid(), 'baseline': baseline}))
        tab = 'Favorites' if baseline in favorite_values() and baseline in choices else 'All'
        (session / 'tab').write_text(tab)
        picker = Picker(choices, session)
        command = shlex.join([str(Path(__file__).resolve()), '--callback', str(session)])
        request = shlex.quote(str(session / 'request'))
        temporary = shlex.quote(str(session)) + '/request.$$'
        publish = f"printf '%s' {{3}} > {temporary} && mv {temporary} {request}"
        initial = rows(choices, tab, baseline)
        position = next((i for i, line in enumerate(initial.splitlines(), 1) if line.split('\t')[2] == baseline), 1)
        env = dict(os.environ, GHOSTTY_THEME_TAB=str(session / 'tab'), THEME_PICKER_SESSION=str(session))
        args = ['fzf', '--no-multi', '--no-preview', '--layout=reverse', '--prompt=theme ▶ ', '--delimiter=\t', '--with-nth=1,2', '--nth=2', '--accept-nth=3', '--id-nth=3', '--header='+tab_header(tab),
                '--footer=tab switch · ctrl-f ★ favorite · enter keep · esc cancel',
                '--bind', f'load:pos({position})+unbind(load)',
                '--bind', f'focus:execute-silent({publish})',
                '--bind', f'tab:transform({command} tab)', '--bind', f'shift-tab:transform({command} tab backward)',
                '--bind', f'ctrl-f:execute-silent({command} star {{3}})+track-current+reload-sync({command} list)']
        process = None
        stopping = False
        def stop(*_):
            nonlocal stopping
            stopping = True
        handlers = {sig: signal.signal(sig, stop) for sig in (signal.SIGTERM, signal.SIGINT)}
        try:
            with tempfile.TemporaryFile(mode='w+') as source, tempfile.TemporaryFile(mode='w+') as output:
                source.write(initial)
                source.seek(0)
                process = subprocess.Popen(args, stdin=source, stdout=output, text=True, env=env)
                observed, pending, changed = None, None, 0
                while not stopping and process.poll() is None:
                    latest = (session / 'request').read_text() if (session / 'request').exists() else ''
                    if latest != observed:
                        observed, pending, changed = latest, latest, time.monotonic()
                    if pending and time.monotonic() - changed >= .06:
                        if process.poll() is not None:
                            break
                        picker.preview(pending)
                        pending = None
                    time.sleep(.02)
                output.seek(0)
                selected = output.read().strip()
            if stopping:
                raise KeyboardInterrupt
            with locked(session / 'callback.lock'):
                (session / 'closed').touch()
            if process.returncode == 0:
                picker.commit(selected)
            elif process.returncode not in (1, 130):
                raise ValueError(f'fzf exited with status {process.returncode}')
        finally:
            try:
                if process is not None and process.poll() is None:
                    process.terminate()
                    process.wait()
                with locked(session / 'callback.lock'):
                    (session / 'closed').touch()
                    recover(session_lock_held=True)
            finally:
                for sig, handler in handlers.items():
                    signal.signal(sig, handler)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('choice', nargs='?')
    parser.add_argument('--adaptive', action='store_true')
    parser.add_argument('--dark', action='store_true')
    parser.add_argument('--light', action='store_true')
    parser.add_argument('--compile', action='store_true')
    parser.add_argument('--check', action='store_true')
    parser.add_argument('--reconcile', action='store_true')
    parser.add_argument('--callback', nargs='+', help=argparse.SUPPRESS)
    args = parser.parse_args()
    if args.callback:
        callback(*args.callback, *([''] if len(args.callback) == 2 else []))
        return
    if args.compile or args.check:
        compile_catalog(args.check)
        return
    families, choices = catalog()
    with locked(STATE / 'owner.lock', blocking=False):
        recover()
        if args.reconcile:
            source = CONFIG if CONFIG.exists() else ROOT / 'config/ghostty/config.ghostty'
            write_bytes(HERDR, render_herdr(current_theme(source)))
            return
        if args.choice:
            value = args.choice
            family = next((f for f in families if f['id'] == value), None)
            if family:
                pair = family['adaptive']
                if args.dark:
                    mode = 'dark'
                elif args.light:
                    mode = 'light'
                elif pair or args.adaptive:
                    mode = 'adaptive'
                else:
                    mode = None
                if mode == 'adaptive':
                    if pair is None:
                        raise ValueError(f"{family['label']} does not support adaptive appearance")
                    value = f"light:{theme_name(family['id'], pair['light'])},dark:{theme_name(family['id'], pair['dark'])}"
                else:
                    variant = pair[mode] if pair else next((key for key, data in family['variants'].items()
                                                           if mode is None or data['appearance'] == mode), None)
                    if variant is None:
                        raise ValueError(f"{family['label']} does not support {mode} appearance")
                    value = theme_name(family['id'], variant)
            if value not in choices:
                raise ValueError(f'unsupported theme choice: {value!r}')
            picker = Picker(choices, None)
            try:
                picker.commit(value)
            finally:
                recover()
        else:
            desired = render_herdr(current_theme())
            if read_bytes(HERDR) != desired:
                write_bytes(HERDR, desired)
                reload_apps()
            run_picker(choices)


if __name__ == '__main__':
    signal.signal(signal.SIGTERM, lambda *_: (_ for _ in ()).throw(KeyboardInterrupt()))
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
    except (ValueError, KeyError, TypeError, OSError, subprocess.CalledProcessError) as error:
        print(f'ghostty-theme: {error}', file=sys.stderr)
        sys.exit(1)
