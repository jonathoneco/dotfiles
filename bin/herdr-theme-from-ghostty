#!/usr/bin/env bash
# Write a Herdr theme file from a Ghostty theme, so Herdr's frame stays
# readable in whatever theme Ghostty shows. Terminal themes don't agree on
# what their numbered colors are for, so no fixed ANSI slot reads well in
# all of them; this derives exact colors from each theme instead:
#
#   active_row_bg  the theme background mixed 15% toward its foreground
#   surface_dim    dividers: the same mix at 30%
#   accent         the theme's blue (palette 4)
#   accent_text    the theme background or foreground, whichever reads
#                  better on the accent; pure black or white when neither
#                  reaches 4.5:1
#   muted text     the theme foreground
#
# A `light:<A>,dark:<B>` value writes [light] and [dark] tables, which Herdr
# applies when theme.auto_switch follows the terminal's appearance.
#
#   herdr-theme-from-ghostty [<ghostty theme line value>]
#
# Without a value it reads the theme line from ~/.config/ghostty/config.ghostty.
# On a machine without Ghostty's themes it writes a file holding only
# `base = "terminal"`, so `[theme] name = "ghostty"` still resolves.
# Writes $HERDR_THEME_FILE (default ~/.config/herdr/themes/ghostty.toml).
set -euo pipefail

value="${1:-$(sed -n 's/^theme = "\(.*\)"$/\1/p' "$HOME/.config/ghostty/config.ghostty" 2>/dev/null || true)}"
out="${HERDR_THEME_FILE:-$HOME/.config/herdr/themes/ghostty.toml}"
themes_dir=""
for dir in ${GHOSTTY_RESOURCES_DIR:+"$GHOSTTY_RESOURCES_DIR"} /Applications/Ghostty.app/Contents/Resources/ghostty /usr/share/ghostty; do
    if [[ -d $dir/themes ]]; then
        themes_dir="$dir/themes"
        break
    fi
done

# colors <theme name> — TOML color lines for one Ghostty theme.
colors() {
    local file="$themes_dir/$1"
    [[ -f $file ]] || { echo "herdr-theme-from-ghostty: no Ghostty theme named '$1'" >&2; return 1; }
    awk '
        function hex(s,  i, n) {
            n = 0; s = tolower(s)
            for (i = 1; i <= length(s); i++) n = n * 16 + index("0123456789abcdef", substr(s, i, 1)) - 1
            return n
        }
        function chan(c, i) { return hex(substr(c, 2 + 2 * i, 2)) }
        function lin(v) { v /= 255; return v <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ^ 2.4 }
        function lum(c) { return 0.2126 * lin(chan(c, 0)) + 0.7152 * lin(chan(c, 1)) + 0.0722 * lin(chan(c, 2)) }
        function ratio(a, b,  x, y) { x = lum(a); y = lum(b); return x > y ? (x + 0.05) / (y + 0.05) : (y + 0.05) / (x + 0.05) }
        function mix(a, b, t,  i, s) {
            s = "#"
            for (i = 0; i < 3; i++) s = s sprintf("%02x", int(chan(a, i) + (chan(b, i) - chan(a, i)) * t + 0.5))
            return s
        }
        /^background *=/ { bg = $NF }
        /^foreground *=/ { fg = $NF }
        /^palette *= *4=/ { accent = $NF; sub(/^4=/, "", accent) }
        END {
            if (bg == "" || fg == "" || accent == "") { print "missing background, foreground or palette 4" > "/dev/stderr"; exit 1 }
            text_on = ratio(bg, accent) >= ratio(fg, accent) ? bg : fg
            if (ratio(text_on, accent) < 4.5) text_on = ratio("#000000", accent) >= ratio("#ffffff", accent) ? "#000000" : "#ffffff"
            printf "accent = \"%s\"\naccent_text = \"%s\"\n", accent, text_on
            printf "active_row_bg = \"%s\"\nsurface_dim = \"%s\"\n", mix(bg, fg, 0.15), mix(bg, fg, 0.30)
            printf "overlay0 = \"reset\"\noverlay1 = \"reset\"\nsubtext0 = \"reset\"\nmauve = \"reset\"\n"
        }' "$file"
}

body=""
if [[ -z $themes_dir || -z $value ]]; then
    value="${value:-none}"
elif [[ $value =~ ^light:(.*),dark:(.*)$ ]]; then
    light="${BASH_REMATCH[1]}"
    dark="${BASH_REMATCH[2]}"
    body="$(colors "$dark")"$'\n\n[light]\n'"$(colors "$light")"$'\n\n[dark]\n'"$(colors "$dark")"
else
    body="$(colors "$value")"
fi

mkdir -p "$(dirname "$out")"
tmp="$(mktemp "$out.XXXXXX")"
{
    printf '# Generated by herdr-theme-from-ghostty from Ghostty theme "%s". Do not edit.\n' "$value"
    printf 'base = "terminal"\n'
    printf '%s\n' "$body"
} >"$tmp"
mv "$tmp" "$out"
