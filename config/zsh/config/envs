#!/usr/bin/env bash
# Editor used by CLI
export SUDO_EDITOR="$EDITOR"
export BAT_THEME=ansi

export LANG=en_US.UTF-8
export MANPAGER='nvim +Man!'
export CC="clang"
export CXX="clang++"

export GOPATH=$HOME/.local/go
export GIT_EDITOR=$EDITOR

export ZSH_PLUGINS_DIR=/usr/share/zsh/plugins

if [ -n "${XDG_CACHE_HOME:-}" ] && [ -w "$XDG_CACHE_HOME" ]; then
  export GOCACHE="$XDG_CACHE_HOME/go-build"
else
  export GOCACHE="/tmp/go-build-cache"
fi

export PNPM_HOME="$HOME/.local/share/pnpm"
export PATH="$PNPM_HOME:$PATH"

export DOCKER_FOLDER="$HOME/mnt/garden-bed"

if [[ -r "$HOME/.local/secrets/secrets.env" ]]; then
  # shellcheck source=/dev/null
  source "$HOME/.local/secrets/secrets.env"
fi

export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/.cargo/bin:$PATH"

addToPathFront "$HOME/.npm-global/bin"
addToPathFront "$HOME/.local/bin"
addToPathFront "$HOME/.cargo/bin"
addToPath "$GOPATH/bin"

export CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1

# playwright-cli gives each named session its own browser. An agent in a Herdr
# pane gets a name from its pane, so two agents never share a page; a session
# that sets the name itself, or a handoff that reuses one, is left as it is.
if [[ -z "${PLAYWRIGHT_CLI_SESSION:-}" && -n "${HERDR_PANE_ID:-}" ]]; then
  export PLAYWRIGHT_CLI_SESSION="agent-${HERDR_PANE_ID//[^A-Za-z0-9]/-}"
fi

# On SSH'd / headless boxes, route URL opens through OSC 8 hyperlinks so the
# local terminal (foot/kitty/wezterm) renders them as clickable links and
# ctrl+click invokes xdg-open on the laptop.
if [[ -n "${SSH_CONNECTION:-}" ]] && [[ -x "$HOME/.local/bin/open-url" ]]; then
    export BROWSER="$HOME/.local/bin/open-url"
fi
