#!/usr/bin/env bash
if command -v mise &> /dev/null; then
  eval "$(mise activate zsh)"
fi

if command -v starship &> /dev/null; then
  eval "$(starship init zsh)"
fi

if command -v zoxide &> /dev/null; then
  eval "$(zoxide init zsh)"
fi

# fzf 0.48+ prints its own shell integration, which every distro's build
# supports the same way; mise pins fzf latest and activates above, so this is
# the normal path. The file lookups are the fallback for a system fzf too old
# for the flag — Homebrew, Arch, and Debian/Ubuntu each put them elsewhere.
if command -v fzf &> /dev/null; then
  if fzf --zsh &> /dev/null; then
    source <(fzf --zsh)
  else
    for _fzf_dir in /opt/homebrew/opt/fzf/shell /usr/share/fzf /usr/share/doc/fzf/examples; do
      [[ -f "$_fzf_dir/completion.zsh" ]] && source "$_fzf_dir/completion.zsh" && break
    done
    for _fzf_dir in /opt/homebrew/opt/fzf/shell /usr/share/fzf /usr/share/doc/fzf/examples; do
      [[ -f "$_fzf_dir/key-bindings.zsh" ]] && source "$_fzf_dir/key-bindings.zsh" && break
    done
    unset _fzf_dir
  fi
fi

# Stamp per user: on a shared box the first login owns /tmp/.dotfiles-pull and
# everyone else's auto-pull goes quiet for four hours, or fails on a file they
# cannot touch.
_dotfiles_stamp="/tmp/.dotfiles-pull-$(id -u)"
if [[ ! -f "$_dotfiles_stamp" ]] || [[ -n $(find "$_dotfiles_stamp" -mmin +240 2>/dev/null) ]]; then
    touch "$_dotfiles_stamp"
    git -C ~/src/dotfiles pull --rebase --quiet &>/dev/null &!
fi
unset _dotfiles_stamp
