--tmux 90%,90%
--multi
--bind='ctrl-o:become($EDITOR {})'
--preview 'fzf-preview {}'
--padding=0% --color='dark,fg:magenta'
--layout=reverse
--border-label=' Search '
--info=hidden
--prompt='▶ '
--pointer='▶'
--marker=''
--padding 0,1
--margin 0,0
--border
--style=full
--no-scrollbar
--bind 'focus:transform-preview-label:[[ -n {} ]] && printf \" %s \" {}'
--color=dark
# ANSI color names, not hex, so fzf follows Ghostty's theme.
--color 'border:black,label:bright-black'
--color 'input-border:black,input-label:magenta'
--color 'preview-border:black,list-border:black'
--color 'gutter:-1,current-bg:black'
--color 'current-hl:yellow,list-fg:bright-black'
--color 'pointer:yellow,marker:yellow'
